# ==============================================================================
# ERP - Production Environment Configuration Template (.env)
# Rename to .env and configure secret keys securely in production.
# ==============================================================================

# ASP.NET Core Runtime Environment: Development, Staging, Production
ASPNETCORE_ENVIRONMENT=Production

# SQL Server Database Configuration
SA_PASSWORD=YourStrong!Password_2026_ERP
DB_SERVER=db
DB_NAME=ERP
DB_PORT=1433

# Database Connection String for App
ConnectionStrings__DefaultConnection=Server=db,1433;Database=ERP;User Id=sa;Password=YourStrong!Password_2026_ERP;TrustServerCertificate=True;MultipleActiveResultSets=True;Encrypt=False;

# JWT Authentication Secrets (Must be at least 32 characters)
JWT_SECRET_KEY=CHANGE_ME_generate_a_random_value_of_at_least_32_characters
JWT_ISSUER=ERP.Security
JWT_AUDIENCE=ERP.Client

# Nginx Domain / Host
DOMAIN_NAME=erp.local
SSL_CERT_PATH=./deploy/nginx/certs/erp.crt
SSL_KEY_PATH=./deploy/nginx/certs/erp.key
